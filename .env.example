# Copy this file to .env and fill in the actual values.
# When running with Docker, use 'db' as the host (the service name in docker-compose).
# When running locally (without Docker), use 'localhost' as the host.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/mgmgives
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me
SERVER_PORT=8080
JWT_SECRET=replace_with_at_least_64_random_characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

FROM_MAIL=your_email@example.com
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_mail_app_password
MAIL_VERIFY_EXPIRATION=864000000
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Default admin user seeded on first startup (required)

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_before_use
SEED_ADMIN_FULL_NAME=Admin

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite
WEBEX_CLIENT_ID=your_webex_client_id
WEBEX_CLIENT_SECRET=your_webex_client_secret
WEBEX_REFRESH_TOKEN=your_webex_refresh_token
WEBEX_API_BASE_URL=https://webexapis.com/v1
WEBEX_REDIRECT_URI=http://localhost:8080/api/integrations/webex/oauth/callback

PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_CANCEL_URL=http://localhost:3000/donation/cancel
PAYOS_RETURN_URL=http://localhost:3000/donation/success
PAYOS_WEBHOOK_URL=https://api.example.com/api/donations/payos/webhook
