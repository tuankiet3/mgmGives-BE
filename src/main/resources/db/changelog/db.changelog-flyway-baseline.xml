<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!--
        Transition contract:
        - a fresh database has no Flyway history and executes V1-V44;
        - an existing database must have a successful Flyway V44 entry;
        - a partial Flyway database halts before any Liquibase changes are applied.
    -->
    <changeSet id="flyway-to-liquibase-transition-guard" author="mgmgives">
        <preConditions onFail="HALT" onError="HALT">
            <or>
                <not>
                    <tableExists schemaName="public" tableName="flyway_schema_history"/>
                </not>
                <and>
                    <tableExists schemaName="public" tableName="flyway_schema_history"/>
                    <sqlCheck expectedResult="1"><![CDATA[
                        SELECT CASE WHEN EXISTS (
                            SELECT 1
                            FROM public.flyway_schema_history
                            WHERE version = '44' AND success = TRUE
                        ) THEN 1 ELSE 0 END
                    ]]></sqlCheck>
                </and>
            </or>
        </preConditions>
        <comment>Reject partially migrated Flyway databases before adopting Liquibase.</comment>
        <sql>SELECT 1</sql>
    </changeSet>

